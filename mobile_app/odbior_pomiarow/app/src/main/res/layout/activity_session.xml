<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <Button
        android:id="@+id/btnBackFromSessions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="← POWRÓT" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="MENEDŻER TRENINGÓW I SESJI"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="12dp" />

    <EditText
        android:id="@+id/etSessionName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Nazwa treningu (np. Trening_Rzutow_Wolnych)"
        android:inputType="text" />

    <Button
        android:id="@+id/btnToggleSession"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:text="ROZPOCZNIJ NOWY TRENING"
        android:textStyle="bold"
        android:layout_marginTop="8dp" />

    <TextView
        android:id="@+id/tvActiveSessionStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Status: Brak aktywnego treningu"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="16dp"
        android:textSize="12sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="ZAPISANE SESJE TRENINGOWE:"
        android:textStyle="bold"
        android:textSize="14sp"
        android:layout_marginBottom="8dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/sessionsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

</LinearLayout>