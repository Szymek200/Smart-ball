<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#FAFAFA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="KONFIGURACJA URZĄDZENIA"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center"
            android:textColor="#37474F"
            android:layout_marginBottom="24dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Czułość wybudzenia (Rejestr sprzętowy 1-127)"
            android:textStyle="bold"
            android:textColor="#263238" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">
            <EditText
                android:id="@+id/etWakeupThreshold"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="np. 20"
                android:inputType="number" />
            <Button
                android:id="@+id/btnSetWakeup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="USTAW" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Próg siły uderzenia [G]"
            android:textStyle="bold"
            android:textColor="#263238" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">
            <EditText
                android:id="@+id/etHitThreshold"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="np. 4.5"
                android:inputType="numberDecimal" />
            <Button
                android:id="@+id/btnSetHit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="USTAW" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Czas bezruchu do uśpienia [sekundy]"
            android:textStyle="bold"
            android:textColor="#263238" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">
            <EditText
                android:id="@+id/etIdleTime"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Min. 5 sek"
                android:inputType="number" />
            <Button
                android:id="@+id/btnSetIdle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="USTAW" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Czułość uśpienia (Próg detekcji bezruchu)"
            android:textStyle="bold"
            android:textColor="#263238" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="32dp">
            <EditText
                android:id="@+id/etSleepThreshold"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="np. 0.05"
                android:inputType="numberDecimal" />
            <Button
                android:id="@+id/btnSetSleepThs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="USTAW" />
        </LinearLayout>

        <Button
            android:id="@+id/btnBackFromSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="POWRÓT DO PANELU"
            android:backgroundTint="#607D8B"
            android:textColor="#FFFFFF" />

    </LinearLayout>
</ScrollView>