<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <LinearLayout
        android:id="@+id/fixedHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp"
        android:background="#F5F5F5"
        android:elevation="4dp"
        app:layout_constraintTop_toTopOf="parent">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <Switch
                android:id="@+id/logSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Logowanie CSV" />

            <TextView
                android:id="@+id/connectionStatusTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:text="Status: Łączenie..."
                android:padding="4dp"
                android:textSize="12sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <LinearLayout
            android:id="@+id/sensorDataPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_horizontal">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="H3LIS (400G)"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:textColor="#8B0000"/>
                <TextView android:id="@+id/h3AccelX" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="X: 0.00 G" android:textSize="11sp" android:textColor="#212121"/>
                <TextView android:id="@+id/h3AccelY" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Y: 0.00 G" android:textSize="11sp" android:textColor="#212121"/>
                <TextView android:id="@+id/h3AccelZ" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Z: 0.00 G" android:textSize="11sp" android:textColor="#212121"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_horizontal">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="IMU ACCEL"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:textColor="#4682B4"/>
                <TextView android:id="@+id/imuAccelX" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="X: 0 mg" android:textSize="11sp" android:textColor="#212121"/>
                <TextView android:id="@+id/imuAccelY" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Y: 0 mg" android:textSize="11sp" android:textColor="#212121"/>
                <TextView android:id="@+id/imuAccelZ" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Z: 0 mg" android:textSize="11sp" android:textColor="#212121"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_horizontal">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="IMU GYRO"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:textColor="#00008B"/>
                <TextView android:id="@+id/gyroX" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="X: 0.0 dps" android:textSize="11sp" android:textColor="#212121"/>
                <TextView android:id="@+id/gyroY" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Y: 0.0 dps" android:textSize="11sp" android:textColor="#212121"/>
                <TextView android:id="@+id/gyroZ" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Z: 0.0 dps" android:textSize="11sp" android:textColor="#212121"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.2"
                android:orientation="vertical"
                android:gravity="center_horizontal">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="GPS SYSTEM"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:textColor="#2E8B57"/>
                <TextView android:id="@+id/gpsLat" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Szer: 0.00000°" android:textSize="10sp" android:textColor="#212121"/>
                <TextView android:id="@+id/gpsLon" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Dług: 0.00000°" android:textSize="10sp" android:textColor="#212121"/>
                <TextView android:id="@+id/gpsFix" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="FIX: BRAK" android:textStyle="bold" android:textSize="10sp" android:textColor="#FF0000"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/fixedHeader">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp"
                android:layout_marginBottom="16dp"
                android:background="#E8EAF6">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="KOKPIT STATYSTYK SESJI SMART BALL"
                    android:textStyle="bold"
                    android:textSize="13sp"
                    android:textColor="#1A237E"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:id="@+id/tvSessionShots"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Suma uderzeń: 0"
                    android:textSize="15sp"
                    android:textColor="#263238"
                    android:layout_marginBottom="4dp"/>

                <TextView
                    android:id="@+id/tvSessionEnergy"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Energia sesji: 0.0 J"
                    android:textSize="15sp"
                    android:textColor="#263238"
                    android:layout_marginBottom="4dp"/>

                <TextView
                    android:id="@+id/tvSessionConsistency"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Powtarzalność: 0%"
                    android:textSize="15sp"
                    android:textColor="#263238" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PODGLĄD TELEMETRII NA ŻYWO (SYNCHRONIZOWANY)"
                android:textSize="11sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <!-- KONTENER NA DWA ZSYNCHRONIZOWANE WYKRESY -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="320dp"
                android:orientation="vertical"
                android:layout_marginBottom="16dp"
                android:background="#FFFFFF"
                android:elevation="2dp"
                android:padding="4dp">

                <!-- Górny Wykres: Przyspieszenia IMU oraz High-G H3 -->
                <com.github.mikephil.charting.charts.LineChart
                    android:id="@+id/accelLiveChart"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#E0E0E0" />

                <!-- Dolny Wykres: Rotacja z Żyroskopu -->
                <com.github.mikephil.charting.charts.LineChart
                    android:id="@+id/gyroLiveChart"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />
            </LinearLayout>

            <TextView
                android:id="@+id/lastHitTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Brak uderzeń"
                android:textSize="18sp"
                android:gravity="center"
                android:padding="10dp"
                android:background="#F0F0F0"
                android:layout_marginBottom="16dp"/>

            <Button
                android:id="@+id/btnOpenLastShot"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:text="ANALIZUJ OSTATNIE ZDARZENIE"
                android:textSize="16sp"
                android:textStyle="bold"
                android:backgroundTint="#1A237E"
                android:textColor="#FFFFFF"
                android:layout_marginBottom="16dp" />

            <Button
                android:id="@+id/btnShowHistory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="POKAŻ PEŁNĄ HISTORIĘ" />

            <Button
                android:id="@+id/btnSettings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="USTAWIENIA SENSORA"
                android:backgroundTint="#607D8B"
                android:layout_marginTop="8dp" />

            <Button
                android:id="@+id/btnShowLocation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="LOKALIZACJA SATELITARNA I GSM"
                android:backgroundTint="#4CAF50"
                android:textColor="#FFFFFF"
                android:layout_marginTop="8dp" />

            <Button
                android:id="@+id/btnOpenSessions"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:text="MENEDŻER TRENINGÓW / SESJI"
                android:textSize="15sp"
                android:textStyle="bold"
                android:backgroundTint="#3F51B5"
                android:textColor="#FFFFFF"
                android:layout_marginTop="8dp" />

            <TextView
                android:id="@+id/statusTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Status: Gotowy" />

            <LinearLayout
                android:id="@+id/hitHistoryContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>