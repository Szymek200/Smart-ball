<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#FAFAFA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="USTAWIENIA"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center"
            android:textColor="#37474F"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/btnClearCache"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="WYCZYŚĆ PAMIĘĆ PODRĘCZNĄ (RAM)"
            android:textColor="#FFFFFF"
            android:backgroundTint="#D32F2F"
            android:layout_marginTop="16dp" />

        <!-- 1. Czułość wybudzenia -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Czułość wybudzenia (Rejestr sprzętowy 1-127)"
            android:textStyle="bold"
            android:textColor="#263238" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">
            <EditText
                android:id="@+id/etWakeupThreshold"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="np. 20"
                android:inputType="number" />
            <Button
                android:id="@+id/btnSetWakeup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="USTAW" />
        </LinearLayout>

        <!-- 2. Próg siły uderzenia -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Próg siły uderzenia [G]"
            android:textStyle="bold"
            android:textColor="#263238" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">
            <EditText
                android:id="@+id/etHitThreshold"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="np. 4.5"
                android:inputType="numberDecimal" />
            <Button
                android:id="@+id/btnSetHit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="USTAW" />
        </LinearLayout>

        <!-- 3. Czas bezruchu -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Czas bezruchu do uśpienia [sekundy]"
            android:textStyle="bold"
            android:textColor="#263238" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">
            <EditText
                android:id="@+id/etIdleTime"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Min. 5 sek"
                android:inputType="number" />
            <Button
                android:id="@+id/btnSetIdle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="USTAW" />
        </LinearLayout>

        <!-- 4. Czułość uśpienia -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Czułość uśpienia (Próg detekcji bezruchu)"
            android:textStyle="bold"
            android:textColor="#263238" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">
            <EditText
                android:id="@+id/etSleepThreshold"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="np. 0.05"
                android:inputType="numberDecimal" />
            <Button
                android:id="@+id/btnSetSleepThs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="USTAW" />
        </LinearLayout>

        <!-- 5. Masa piłki -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Masa piłki [kg]"
            android:textStyle="bold"
            android:textColor="#263238" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">
            <EditText
                android:id="@+id/etBallMass"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="np. 0.43"
                android:inputType="numberDecimal" />
            <Button
                android:id="@+id/btnSetBallMass"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="USTAW" />
        </LinearLayout>

        <!-- 6. Próg lotu -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Próg swobodnego lotu / nieważkości [mg]"
            android:textStyle="bold"
            android:textColor="#263238" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">
            <EditText
                android:id="@+id/etAirThreshold"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="np. 300"
                android:inputType="numberDecimal" />
            <Button
                android:id="@+id/btnSetAirThreshold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="USTAW" />
        </LinearLayout>

        <!-- 7. Minimalny próg rotacji -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Minimalny próg rotacji [dps]"
            android:textStyle="bold"
            android:textColor="#263238" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="24dp">
            <EditText
                android:id="@+id/etMinSpin"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="np. 10.0"
                android:inputType="numberDecimal" />
            <Button
                android:id="@+id/btnSetMinSpin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="USTAW" />
        </LinearLayout>

        <Button
            android:id="@+id/btnBackFromSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="POWRÓT DO PANELU"
            android:backgroundTint="#607D8B"
            android:textColor="#FFFFFF" />

    </LinearLayout>
</ScrollView>